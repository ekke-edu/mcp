# A read-only GitHub personal access token is required for Discussions via GraphQL.
# Never commit a real token. For public repositories, a classic token needs public_repo scope.
GITHUB_TOKEN=

# Optional comma-separated overrides. Repositories must be public.
EKKE_COURSE_REPOS=ekke-edu/advanced-databases-2,ekke-edu/complex-ai-applications,ekke-edu/modern-databases,ekke-edu/cloud-computing
EKKE_DISCUSSION_REPOS=ekke-edu/advanced-databases-2,ekke-edu/complex-ai-applications,ekke-edu/modern-databases,ekke-edu/cloud-computing,ekke-edu/.github
