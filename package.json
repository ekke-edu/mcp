{
  "name": "ekke-mcp",
  "version": "0.2.2",
  "description": "Bilingual MCP search for EKKE course repositories, discussions, and official university pages.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ekke-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "config/sources.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepack": "pnpm run build",
    "test": "node --test",
    "release:patch": "pnpm version patch --message \"chore: release v%s\"",
    "release:minor": "pnpm version minor --message \"chore: release v%s\"",
    "release:major": "pnpm version major --message \"chore: release v%s\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ekke-edu/mcp.git"
  }
}
